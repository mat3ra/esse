{
    "$id": "workflow/unit/context/item/path",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "path context item schema",
    "type": "object",
    "required": [
        "name",
        "isEdited",
        "data",
        "extraData"
    ],
    "properties": {
        "name": {
            "type": "string",
            "enum": [
                "qpath",
                "ipath",
                "kpath",
                "explicitKPath",
                "explicitKPath2PIBA"
            ]
        },
        "data": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "Points Path Data Provider Schema",
            "description": "Path in reciprocal space for band structure calculations. User-editable and persisted fields only (coordinates are derived at render time).",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "point",
                    "steps"
                ],
                "properties": {
                    "point": {
                        "type": "string"
                    },
                    "steps": {
                        "type": "number"
                    }
                }
            }
        },
        "extraData": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "extraData with materialHash schema",
            "type": "object",
            "properties": {
                "materialHash": {
                    "type": "string",
                    "description": "UI only property used to track material change for re-render"
                }
            }
        },
        "isEdited": {
            "type": "boolean"
        }
    }
}