{
    "$id": "workflow/unit/context/item/hubbard-v",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "hubbard_v context item schema",
    "type": "object",
    "required": [
        "name",
        "isEdited",
        "data",
        "extraData"
    ],
    "properties": {
        "name": {
            "type": "string",
            "const": "hubbard_v"
        },
        "data": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "Hubbard V Context Provider Schema",
            "description": "Hubbard V parameters for DFT+U+V calculation.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "atomicSpecies": {
                        "type": "string",
                        "title": "Species 1"
                    },
                    "siteIndex": {
                        "type": "integer",
                        "title": "Site no 1"
                    },
                    "atomicOrbital": {
                        "type": "string",
                        "title": "Orbital 1"
                    },
                    "atomicSpecies2": {
                        "type": "string",
                        "title": "Species 2"
                    },
                    "siteIndex2": {
                        "type": "integer",
                        "title": "Site no 2"
                    },
                    "atomicOrbital2": {
                        "type": "string",
                        "title": "Orbital 2"
                    },
                    "hubbardVValue": {
                        "type": "number",
                        "title": "V (eV)"
                    }
                }
            }
        },
        "isEdited": {
            "type": "boolean"
        },
        "extraData": {
            "type": "object"
        }
    }
}