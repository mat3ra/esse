{
    "$id": "workflow/unit/context/ml-settings",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "mlSettings context item schema",
    "type": "object",
    "required": [
        "name",
        "isEdited",
        "data"
    ],
    "properties": {
        "name": {
            "type": "string",
            "const": "mlSettings"
        },
        "data": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "ML Settings Context Provider Schema",
            "description": "Settings important to machine learning runs.",
            "type": "object",
            "properties": {
                "target_column_name": {
                    "type": "string"
                },
                "problem_category": {
                    "type": "string",
                    "enum": [
                        "regression",
                        "classification",
                        "clustering"
                    ]
                }
            }
        },
        "isEdited": {
            "type": "boolean"
        }
    }
}