{
    "$id": "workflow/unit/runtime/-runtime-item-name-object",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "name result schema",
    "type": "object",
    "required": [
        "name"
    ],
    "properties": {
        "name": {
            "description": "The name of this item. e.g. scf_accuracy",
            "type": "string"
        },
        "filetype": {
            "description": "Type of result file, e.g. image, text",
            "type": "string"
        },
        "basename": {
            "description": "Base filename of the result file",
            "type": "string"
        }
    }
}