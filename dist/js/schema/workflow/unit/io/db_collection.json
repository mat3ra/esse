{
    "$id": "workflow/unit/io/db-collection",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "data IO database collection input/output schema",
    "type": "object",
    "required": [
        "type",
        "collection",
        "draft"
    ],
    "properties": {
        "type": {
            "const": "db_collection"
        },
        "collection": {
            "description": "db collection name",
            "type": "string"
        },
        "draft": {
            "description": "whether the result should be saved as draft",
            "type": "boolean"
        }
    }
}