{
    "$id": "material/builders/single-material/two-dimensional/slab/builder-parameters",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Slab Builder Parameters Schema",
    "description": "Parameters for the slab builder",
    "type": "object",
    "properties": {
        "min_vacuum_size": {
            "description": "Minimum size of the vacuum in layers or angstroms",
            "type": [
                "integer",
                "number"
            ],
            "minimum": 0,
            "default": 1
        },
        "in_unit_planes": {
            "description": "Whether to cleave in unit planes",
            "type": "boolean",
            "default": true
        },
        "reorient_lattice": {
            "description": "Whether to reorient the lattice",
            "type": "boolean",
            "default": true
        },
        "symmetrize": {
            "description": "Whether to symmetrize the slab",
            "type": "boolean",
            "default": true
        }
    }
}