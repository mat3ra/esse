{
    "$id": "material/reusable/coordinate-conditions/plane",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Plane Coordinate Condition Schema",
    "type": "object",
    "required": [
        "plane_normal",
        "plane_point_coordinate",
        "shape"
    ],
    "description": "Base interface for coordinate shape filters",
    "properties": {
        "shape": {
            "const": "plane",
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "Coordinate Shape Enum",
            "type": "string",
            "enum": [
                "cylinder",
                "sphere",
                "box",
                "triangular_prism",
                "plane"
            ]
        },
        "plane_normal": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
                "type": "number"
            }
        },
        "plane_point_coordinate": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
                "type": "number"
            }
        }
    }
}