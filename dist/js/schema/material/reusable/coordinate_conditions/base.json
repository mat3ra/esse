{
    "$id": "material/reusable/coordinate-conditions/base",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Coordinate Condition Schema",
    "description": "Base interface for coordinate shape filters",
    "type": "object",
    "required": [
        "shape"
    ],
    "properties": {
        "shape": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "Coordinate Shape Enum",
            "type": "string",
            "enum": [
                "cylinder",
                "sphere",
                "box",
                "triangular_prism",
                "plane"
            ]
        }
    }
}