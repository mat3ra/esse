{
    "$id": "material/reusable/coordinate-conditions/box",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Box Coordinate Condition Schema",
    "type": "object",
    "required": [
        "max_coordinate",
        "min_coordinate",
        "shape"
    ],
    "description": "Base interface for coordinate shape filters",
    "properties": {
        "shape": {
            "const": "box",
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "Coordinate Shape Enum",
            "type": "string",
            "enum": [
                "cylinder",
                "sphere",
                "box",
                "triangular_prism",
                "plane"
            ]
        },
        "min_coordinate": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
                "type": "number"
            }
        },
        "max_coordinate": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
                "type": "number"
            }
        }
    }
}