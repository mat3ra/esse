{
    "$id": "core/reusable/coordinate-conditions/sphere",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Sphere Coordinate Condition Schema",
    "description": "Coordinate condition for a sphere (or ellipsoid when using crystal coordinates).",
    "type": "object",
    "required": [
        "center_coordinate",
        "radius",
        "shape"
    ],
    "properties": {
        "shape": {
            "const": "sphere",
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "Coordinate Shape Enum",
            "type": "string",
            "enum": [
                "cylinder",
                "sphere",
                "box",
                "triangular_prism",
                "plane"
            ]
        },
        "center_coordinate": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "coordinate 3d schema",
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
                "type": "number"
            }
        },
        "radius": {
            "type": "number"
        }
    }
}