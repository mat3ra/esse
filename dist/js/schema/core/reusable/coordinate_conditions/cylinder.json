{
    "$id": "core/reusable/coordinate_conditions/cylinder",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Cylinder Coordinate Condition Schema",
    "required": [
        "max_z",
        "min_z",
        "radius",
        "shape"
    ],
    "description": "Base interface for coordinate shape filters",
    "type": "object",
    "properties": {
        "shape": {
            "const": "cylinder",
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "Coordinate Shape Enum",
            "type": "string",
            "enum": [
                "cylinder",
                "sphere",
                "box",
                "triangular_prism",
                "plane"
            ]
        },
        "radius": {
            "type": "number",
            "minimum": 0
        },
        "min_z": {
            "type": "number"
        },
        "max_z": {
            "type": "number"
        }
    }
}