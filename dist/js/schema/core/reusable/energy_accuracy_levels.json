{
    "$id": "core/reusable/energy-accuracy-levels",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Reusable schema for accuracy levels with value and energy unit",
    "type": "object",
    "required": [
        "accuracy_level",
        "unit",
        "value"
    ],
    "properties": {
        "accuracy_level": {
            "description": "Parameter value suitable for a specific accuracy level.",
            "type": "string",
            "enum": [
                "standard",
                "low",
                "high"
            ]
        },
        "unit": {
            "enum": [
                "kJ/mol",
                "eV",
                "J/mol",
                "hartree",
                "cm-1",
                "Ry",
                "eV/atom"
            ]
        },
        "value": {
            "type": "number"
        }
    }
}