                        "Xe",
                        "Cs",
                        "Ba",
                        "La",
                        "Ce",
                        "Pr",
                        "Nd",
                        "Pm",
                        "Sm",
                        "Eu",
                        "Gd",
                        "Tb",
                        "Dy",
                        "Ho",
                        "Er",
                        "Tm",
                        "Yb",
                        "Lu",
                        "Hf",
                        "Ta",
                        "W",
                        "Re",
                        "Os",
                        "Ir",
                        "Pt",
                        "Au",
                        "Hg",
                        "Tl",
                        "Pb",
                        "Bi",
                        "Po",
                        "At",
                        "Rn",
                        "Fr",
                        "Ra",
                        "Ac",
                        "Th",
                        "Pa",
                        "U",
                        "Np",
                        "Pu",
                        "Am",
                        "Cm",
                        "Bk",
                        "Cf",
                        "Es",
                        "Fm",
                        "Md",
                        "No",
                        "Lr",
                        "Rf",
