                {
                    "type": "string",
                    "pattern": "^[A-Z][a-z]?([A-Z][a-z]?)*$"
                }
            ]
        },
        "space_group_symmetry_label": {
            "title": "Space Group Symmetry Label",
            "description": "Space group symmetry designation for the termination",
            "type": "string"
        }
    }
}