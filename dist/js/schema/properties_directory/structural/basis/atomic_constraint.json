{
    "$id": "properties-directory/structural/basis/atomic-constraint",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "atomic constraint schema",
    "description": "constraint of atoms by ids, used to constraint the position etc.",
    "type": "object",
    "required": [
        "id"
    ],
    "properties": {
        "value": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "vector boolean 3d schema",
            "oneOf": [
                {
                    "$schema": "http://json-schema.org/draft-07/schema#",
                    "title": "array of 3 boolean elements schema",
                    "type": "array",
                    "items": {
                        "type": "boolean"
                    },
                    "minItems": 3,
                    "maxItems": 3
                }
            ]
        },
        "id": {
            "description": "integer id of this entry",
            "type": "integer"
        }
    }
}