{
    "$id": "system/runtime-items-string",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "runtime items string schema",
    "type": "object",
    "required": [
        "preProcessors",
        "postProcessors",
        "monitors",
        "results"
    ],
    "properties": {
        "preProcessors": {
            "description": "names of the pre-processors for this calculation",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "postProcessors": {
            "description": "names of the post-processors for this calculation",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "monitors": {
            "description": "names of the monitors for this calculation",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "results": {
            "description": "names of the results for this calculation",
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    }
}