{
    "$id": "software/application/versions",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "application versions schema",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "version": {
            "description": "Application version. e.g. 5.3.5",
            "type": "string"
        },
        "build": {
            "description": "Application build. e.g. VTST",
            "type": "string"
        },
        "isDefault": {
            "description": "Identifies that build is default.",
            "type": "boolean"
        },
        "hasAdvancedComputeOptions": {
            "description": "Whether advanced compute options are present",
            "type": "boolean"
        }
    }
}