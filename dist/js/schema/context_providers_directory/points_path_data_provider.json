{
    "$id": "context-providers-directory/points-path-data-provider",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Points Path Data Provider Schema",
    "description": "Path in reciprocal space for band structure calculations. User-editable and persisted fields only (coordinates are derived at render time).",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "required": [
            "point",
            "steps"
        ],
        "properties": {
            "point": {
                "type": "string"
            },
            "steps": {
                "type": "number"
            }
        }
    }
}