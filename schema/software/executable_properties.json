{
    "$id": "software/executable-properties",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "executable properties schema",
    "type": "object",
    "properties": {
        "hasAdvancedComputeOptions": {
            "description": "Whether advanced compute options are present",
            "type": "boolean",
            "default": false
        },
        "applicationId": {
            "description": "ids of the applications this executable belongs to",
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "applicationId"
    ]
}
