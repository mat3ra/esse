{
    "$id": "software/flavor-properties",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "flavor properties schema",
    "type": "object",
    "properties": {
        "input": {
            "title": "execution unit input schema",
            "type": "array",
            "items": {
                "$ref": "../workflow/unit/input/_inputItemId.json"
            }
        },
        "executableId": {
            "description": "id of the executable this flavor belongs to",
            "type": "string"
        }
    },
    "required": [
        "input",
        "executableId"
    ]
}
