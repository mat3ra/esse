{
    "$id": "core/primitive/array-with-ids",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "array with ids",
    "description": "Object with ids and values, where each id is an integer and each value is any",
    "type": "object",
    "properties": {
        "ids": {
            "description": "Array of integer ids",
            "type": "array",
            "items": {
                "type": "integer"
            }
        },
        "values": {
            "description": "Array of values corresponding to the ids",
            "type": "array",
            "items": {}
        }
    },
    "required": [
        "ids",
        "values"
    ]
}

