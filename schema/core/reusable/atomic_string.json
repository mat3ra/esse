{
    "$id": "core/reusable/atomic-string",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "atomic string schema",
    "description": "object containing integer id and value each",
    "type": "object",
    "required": [
        "id",
        "value"
    ],
    "properties": {
        "value": {
            "type": "string",
            "description": "value of this entry"
        },
        "id": {
            "description": "integer id of this entry",
            "type": "integer"
        }
    }
}