{
    "$id": "core/reusable/coordinate-conditions/plane",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Plane Coordinate Condition Schema",
    "type": "object",
    "allOf": [
        {
            "$ref": "base.json"
        }
    ],
    "properties": {
        "shape": {
            "const": "plane"
        },
        "plane_normal": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
        },
        "plane_point_coordinate": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
        }
    },
    "required": [
        "shape",
        "plane_normal",
        "plane_point_coordinate"
    ]
}
