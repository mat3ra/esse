{
    "$id": "core/reusable/coordinate-conditions/sphere",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Sphere Coordinate Condition Schema",
    "description": "Coordinate condition for a sphere (or ellipsoid when using crystal coordinates).",
    "type": "object",
    "allOf": [
        {
            "$ref": "base.json"
        }
    ],
    "properties": {
        "shape": {
            "const": "sphere"
        },
        "center_coordinate": {
            "$ref": "../../abstract/coordinate_3d.json"
        },
        "radius": {
            "type": "number"
        }
    },
    "required": [
        "center_coordinate",
        "radius"
    ]
}
