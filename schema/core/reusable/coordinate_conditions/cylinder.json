{
    "$id": "core/reusable/coordinate-conditions/cylinder",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Cylinder Coordinate Condition Schema",
    "type": "object",
    "allOf": [
        {
            "$ref": "base.json"
        }
    ],
    "properties": {
        "shape": {
            "const": "cylinder"
        },
        "center_position": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "default": [
                0.5,
                0.5
            ]
        },
        "radius": {
            "type": "number",
            "default": 0.25
        },
        "min_z": {
            "type": "number",
            "default": 0
        },
        "max_z": {
            "type": "number",
            "default": 1
        }
    },
    "required": [
        "shape",
        "radius",
        "min_z",
        "max_z"
    ]
}
