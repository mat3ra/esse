{
    "$id": "core/reusable/energy-accuracy-levels",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Reusable schema for accuracy levels with value and energy unit",
    "type": "object",
    "allOf": [
        {
            "$ref": "../primitive/scalar.json"
        }
    ],
    "properties": {
        "accuracy_level": {
            "description": "Parameter value suitable for a specific accuracy level.",
            "type": "string",
            "enum": [
                "standard",
                "low",
                "high"
            ]
        },
        "unit": {
            "description": "Unit of the energy value corresponding to a accuracy_level. The values are expressed in Ry.",
            "type": "string",
            "enum": [
                "Ry"
            ]
        }
    },
    "required": [
        "accuracy_level",
        "unit"
    ]
}
