{
    "$id": "core/reusable/kpoint-eigenvalues",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "k-point eigenvalues schema",
    "description": "the eigenvalues at one k-point: its coordinates, its integration weight, and the band energies and occupations of each spin channel",
    "type": "object",
    "properties": {
        "kpoint": {
            "$ref": "./kpoint.json"
        },
        "weight": {
            "type": "number"
        },
        "eigenvalues": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "spin": {
                        "type": "number"
                    },
                    "energies": {
                        "type": "array"
                    },
                    "occupations": {
                        "type": "array"
                    }
                }
            }
        }
    }
}
