{
    "$id": "context-providers-directory/by-application/qe-neb-context-provider",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QE NEB Context Provider Schema",
    "description": "Schema for QENEBContextProvider that generates context data for Quantum ESPRESSO pw.x NEB input. Extends the pw.x context with image-specific atomic positions.",
    "allOf": [
        {
            "$ref": "qe_pwx_base_context_provider.json"
        },
        {
            "type": "object",
            "properties": {
                "FIRST_IMAGE": {
                    "$ref": "../../apse/file/applications/espresso/7.2/pw.x/atomic_positions.json"
                },
                "LAST_IMAGE": {
                    "$ref": "../../apse/file/applications/espresso/7.2/pw.x/atomic_positions.json"
                },
                "INTERMEDIATE_IMAGES": {
                    "type": "array",
                    "items": {
                        "$ref": "../../apse/file/applications/espresso/7.2/pw.x/atomic_positions.json"
                    }
                }
            },
            "required": [
                "IBRAV",
                "RESTART_MODE",
                "ATOMIC_SPECIES",
                "ATOMIC_SPECIES_WITH_LABELS",
                "NAT",
                "NTYP",
                "NTYP_WITH_LABELS",
                "CELL_PARAMETERS",
                "FIRST_IMAGE",
                "LAST_IMAGE",
                "INTERMEDIATE_IMAGES"
            ]
        }
    ]
}
