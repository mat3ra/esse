{
    "$id": "property/meta-holder",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Meta property holder schema",
    "type": "object",
    "allOf": [
        {
            "description": "entity schema",
            "$ref": "../in_memory_entity/base.json"
        }
    ],
    "properties": {
        "data": {
            "description": "container of the information, specific to each property",
            "type": "object",
            "oneOf": [
                {
                    "$ref": "../methods_directory/physical/psp/file_data_item.json"
                },
                {
                    "$ref": "../properties_directory/structural/basis/starting_magnetization_property.json"
                }
            ]
        },
        "source": {
            "title": "meta property source schema",
            "type": "object",
            "allOf": [
                {
                    "$ref": "./material_property_source.json"
                }
            ],
            "required": [
                "type"
            ]
        }
    },
    "required": [
        "data",
        "source"
    ]
}
