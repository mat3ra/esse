{
    "$id": "property/proto-holder",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Proto property holder schema",
    "type": "object",
    "allOf": [
        {
            "description": "entity schema",
            "$ref": "../in_memory_entity/base.json"
        }
    ],
    "properties": {
        "data": {
            "description": "container of the information, specific to each property",
            "type": "object",
            "oneOf": [
                {
                    "$ref": "../properties_directory/structural/basis/atomic_constraints_property.json"
                },
                {
                    "$ref": "../properties_directory/structural/basis/atomic_labels_property.json"
                },
                {
                    "$ref": "../properties_directory/structural/basis/boundary_conditions.json"
                }
            ]
        },
        "source": {
            "type": "object",
            "allOf": [
                {
                    "$ref": "./material_property_source.json"
                }
            ],
            "required": [
                "type",
                "info"
            ]
        }
    },
    "required": [
        "data",
        "source"
    ]
}
