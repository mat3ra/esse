{
    "$id": "sample/library/substrate",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "library substrate schema",
    "description": "The base the piece is built on: shape and size; material when known. After SEMI M1 (polished silicon wafer specification).",
    "type": "object",
    "properties": {
        "shape": {
            "description": "e.g. square, round",
            "type": "string"
        },
        "size": {
            "description": "Side of a square, diameter of a round piece, in units",
            "type": "number"
        },
        "units": {
            "$ref": "../../definitions/units.json#/length"
        },
        "material": {
            "description": "e.g. Si",
            "type": "string"
        }
    },
    "required": [
        "shape",
        "size",
        "units"
    ]
}
