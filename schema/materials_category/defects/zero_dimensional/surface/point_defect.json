{
  "$id": "materials-category/defects/configurations/slab-defect/point-defect",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Slab Point Defect Configuration",
  "description": "Configuration for point defects on a slab surface",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../two_dimensional/slab_defect/base.json"
    },
    {
      "$ref": "../../zero_dimensional/point_defect/point_defect.json"
    }
  ],
  "required": ["position_on_surface", "distance_z"],
  "properties": {
    "position_on_surface": {
      "description": "Position on the slab surface in 2D crystal coordinates",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "distance_z": {
      "description": "Distance from the surface in Angstroms",
      "type": "number",
      "minimum": 0
    }
  }
} 