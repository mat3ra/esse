{
    "$id": "materials-category/defects/zero-dimensional/adatom/configuration-without-crystal",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Adatom Configuration Without Crystal Schema",
    "description": "Base configuration for adatom defects on a surface",
    "type": "object",
    "required": [
        "position_on_surface",
        "distance_z",
        "chemical_element"
    ],
    "properties": {
        "crystal": {
            "description": "The base crystal material for the defect",
            "$ref": "../../../../material.json"
        },
        "defect_type": {
            "const": "adatom"
        },
        "position_on_surface": {
            "description": "Position on the surface in 2D crystal coordinates",
            "$ref": "../../../../core/abstract/coordinate_2d.json"
        },
        "distance_z": {
            "description": "Distance from the surface in Angstroms",
            "type": "number",
            "minimum": 0
        },
        "chemical_element": {
            "description": "Chemical element of the adatom",
            "type": "string"
        }
    }
} 
