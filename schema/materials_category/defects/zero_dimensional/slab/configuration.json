{
    "$id": "materials-category/defects/zero-dimensional/slab/configuration",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Slab Point Defect Configuration Schema",
    "description": "Configuration for point defects on a slab surface",
    "type": "object",
    "allOf": [
        {
            "$ref": "../../slab/configuration.json"
        },
        {
            "$ref": "../point/configuration.json"
        }
    ],
    "required": [
        "position_on_surface",
        "distance_z"
    ],
    "properties": {
        "position_on_surface": {
            "description": "Position on the slab surface in 2D crystal coordinates",
            "$ref": "../../../../core/abstract/coordinate_2d.json"
        },
        "distance_z": {
            "description": "Distance from the surface in Angstroms",
            "type": "number",
            "minimum": 0
        }
    }
} 
