{
    "$id": "materials-category/defects/zero-dimensional/defect-pair/configuration",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Point Defect Pair Configuration Schema",
    "description": "Configuration for a pair of point defects",
    "type": "object",
    "required": [
        "primary_defect_configuration",
        "secondary_defect_configuration"
    ],
    "properties": {
        "defect_type": {
            "$ref": "../../enums.json#/complexDefectType",
            "default": "pair"
        },
        "primary_defect_configuration": {
            "description": "Primary defect requires explicit crystal definition",
            "anyOf": [
                {
                    "$ref": "../point/configuration.json"
                },
                {
                    "$ref": "../adatom/configuration.json"
                }
            ]
        },
        "secondary_defect_configuration": {
            "description": "Configuration for the second defect",
            "anyOf": [
                {
                    "$ref": "../point/base_configuration.json"
                },
                {
                    "$ref": "../adatom/base_configuration.json"
                }
            ]
        }
    }
}
