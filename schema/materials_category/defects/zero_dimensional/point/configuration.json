{
    "$id": "materials-category/defects/zero-dimensional/point/configuration",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Point Defect Configuration Schema",
    "description": "Configuration for point defects that require a crystal reference",
    "allOf": [
        {
            "$ref": "base_configuration.json"
        },
        {
            "type": "object",
            "required": [
                "crystal"
            ],
            "properties": {
                "crystal": {
                    "description": "The base crystal material for the defect",
                    "$ref": "../../../../material.json"
                }
            }
        }
    ]
} 
