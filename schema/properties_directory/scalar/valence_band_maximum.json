{
    "$id": "properties-directory/scalar/valence-band-maximum",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Valence band maximum property schema",
    "description": "highest occupied band energy of a crystal",
    "type": "object",
    "allOf": [
        {
            "$ref": "../../core/reusable/energy.json"
        }
    ],
    "properties": {
        "name": {
            "enum": [
                "valence_band_maximum"
            ]
        },
        "kpoint": {
            "description": "k-point at which the valence band maximum occurs, in crystal coordinates",
            "$ref": "../../core/reusable/kpoint.json"
        },
        "spin": {
            "description": "spin of the channel the band edge belongs to",
            "type": "number",
            "enum": [
                0.5,
                -0.5
            ]
        }
    },
    "required": [
        "name"
    ]
}
