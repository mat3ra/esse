{
    "$id": "properties-directory/structural/basis/atomic-label",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "atomic label schema",
    "description": "per-atom integer label, e.g. the part of an interface, as in Fe1, Fe2",
    "type": "object",
    "required": [
        "id",
        "value"
    ],
    "properties": {
        "value": {
            "minimum": 0,
            "type": "integer",
            "description": "value of this entry"
        },
        "id": {
            "description": "integer id of this entry",
            "type": "integer"
        }
    }
}