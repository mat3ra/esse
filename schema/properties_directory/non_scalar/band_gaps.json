{
    "$id": "properties-directory/non-scalar/band-gaps",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Band gaps property schema",
    "description": "contains band gap values",
    "type": "object",
    "required": [
        "name",
        "values"
    ],
    "properties": {
        "name": {
            "enum": [
                "band_gaps"
            ]
        },
        "values": {
            "type": "array",
            "items": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "title": "band gap schema",
                "type": "object",
                "required": [
                    "type",
                    "value"
                ],
                "properties": {
                    "kpointConduction": {
                        "$schema": "http://json-schema.org/draft-07/schema#",
                        "title": "kpoint schema",
                        "description": "A k-point is a point in reciprocal space of a crystal.",
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                            "type": "number"
                        }
                    },
                    "kpointValence": {
                        "$schema": "http://json-schema.org/draft-07/schema#",
                        "title": "kpoint schema",
                        "description": "A k-point is a point in reciprocal space of a crystal.",
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                            "type": "number"
                        }
                    },
                    "eigenvalueConduction": {
                        "description": "eigenvalue at k-point in conduction band",
                        "type": "number"
                    },
                    "eigenvalueValence": {
                        "description": "eigenvalue at k-point in valence band",
                        "type": "number"
                    },
                    "spin": {
                        "type": "number"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "direct",
                            "indirect"
                        ]
                    },
                    "units": {
                        "enum": [
                            "kcal/mol",
                            "kJ/mol",
                            "eV",
                            "J/mol",
                            "hartree",
                            "cm-1",
                            "Ry",
                            "eV/atom"
                        ]
                    },
                    "value": {
                        "type": "number"
                    }
                }
            }
        },
        "eigenvalues": {
            "type": "array",
            "items": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "title": "eigenvalues at k-point schema",
                "description": "the eigenvalues at one k-point: its coordinates, its integration weight, and the band energies and occupations of each spin channel",
                "type": "object",
                "required": [
                    "eigenvalues"
                ],
                "properties": {
                    "kpoint": {
                        "$schema": "http://json-schema.org/draft-07/schema#",
                        "title": "kpoint schema",
                        "description": "A k-point is a point in reciprocal space of a crystal.",
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                            "type": "number"
                        }
                    },
                    "weight": {
                        "type": "number",
                        "description": "integration weight of the k-point"
                    },
                    "eigenvalues": {
                        "type": "array",
                        "description": "one entry per spin channel; a spin-unpolarized calculation has a single entry",
                        "items": {
                            "$schema": "http://json-schema.org/draft-07/schema#",
                            "title": "band energies schema",
                            "description": "the band energies and occupations of one spin channel at one k-point",
                            "type": "object",
                            "required": [
                                "energies"
                            ],
                            "properties": {
                                "spin": {
                                    "description": "spin of the channel",
                                    "type": "number",
                                    "enum": [
                                        0.5,
                                        -0.5
                                    ]
                                },
                                "energies": {
                                    "description": "band energies, in band order",
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    }
                                },
                                "occupations": {
                                    "description": "band occupations, in the same order as energies",
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}