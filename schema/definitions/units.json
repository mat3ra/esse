        "enum": [
            "pm/V",
            "pC/N"
        ]
    },
    "rotation_rate": {
        "enum": [
            "rpm"
        ]
    },
    "dimensionless": {
        "enum": [
            "unitless",
            "percent",
            "ppm",
            "fraction"
        ]
    }
