            "crystal",
            "cartesian"
        ],
        "default": "crystal"
    },
    "length": {
        "enum": [
            "km",
            "m",
            "cm",
            "mm",
            "um",
            "nm",
            "angstrom",
            "a.u.",
            "bohr",
            "pm"
        ]
    },
    "length_atomic": {
        "enum": [
            "angstrom",
            "bohr"
        ],
        "default": "angstrom"
    },
    "energy": {
        "enum": [
            "kcal/mol",
