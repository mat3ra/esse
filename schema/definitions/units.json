{
    "$id": "definitions/units",
    "title": "all units definitions",
    "angle": {
        "enum": [
            "degree",
            "radian"
        ],
        "default": "degree"
    },
    "coordinates_basis": {
        "enum": [
            "crystal",
            "cartesian"
        ],
        "default": "crystal"
    },
    "coordinates_lattice_reciprocal": {
