{
    "$id": "workflow/experimental/instrument",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "instrument schema",
    "type": "object",
    "properties": {
        "name": {
            "description": "Instrument name",
            "type": "string"
        },
        "shortName": {
            "description": "Short name of the instrument",
            "type": "string"
        },
        "summary": {
            "description": "Short description of the instrument",
            "type": "string"
        },
        "version": {
            "description": "Instrument version",
            "type": "string"
        }
    },
    "required": [
        "name"
    ]
}
