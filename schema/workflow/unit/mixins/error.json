{
    "$id": "workflow/unit/mixins/error",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "error unit mixin schema",
    "type": "object",
    "properties": {
        "type": {
            "const": "error"
        },
        "originalUnit": {
            "type": "object",
            "description": "Full pre-conversion unit payload preserved for debugging"
        },
        "reason": {
            "type": "string",
            "description": "Why conversion happened (validation/hydration message)"
        }
    },
    "required": [
        "originalUnit",
        "reason"
    ]
}
