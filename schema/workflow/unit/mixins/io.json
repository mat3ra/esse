{
    "$id": "workflow/unit/mixins/io",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "data IO unit mixin schema",
    "type": "object",
    "properties": {
        "type": {
            "enum": [
                "io"
            ]
        },
        "subtype": {
            "enum": [
                "input",
                "output",
                "dataFrame"
            ]
        },
        "source": {
            "enum": [
                "api",
                "db",
                "object_storage"
            ]
        },
        "input": {
            "type": "array",
            "items": {
                "oneOf": [
                    {
                        "$ref": "../io/api.json"
                    },
                    {
                        "$ref": "../io/db.json"
                    },
                    {
                        "$ref": "../io/object_storage.json"
                    }
                ]
            }
        }
    },
    "required": [
        "subtype",
        "source",
        "input"
    ]
}

