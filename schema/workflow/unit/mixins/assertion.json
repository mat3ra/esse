{
    "$id": "workflow/unit/mixins/assertion",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "assertion unit mixin schema",
    "type": "object",
    "properties": {
        "type": {
            "const": "assertion"
        },
        "statement": {
            "type": "string",
            "description": "The statement to be evaluated",
            "default": "true"
        },
        "errorMessage": {
            "type": "string",
            "description": "The error message to be displayed if the assertion fails",
            "default": "assertion failed"
        }
    },
    "required": [
        "name",
        "statement"
    ]
}
