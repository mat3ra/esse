                                "restart"
                            ],
                            "default": "from_scratch"
                        },
                        "ATOMIC_SPECIES": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "required": [
                                    "X",
                                    "Mass_X",
                                    "PseudoPot_X"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                    "X": {
                                        "type": "string",
