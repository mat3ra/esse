{
    "$id": "material/reusable/coordinate-conditions/box",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Box Coordinate Condition Schema",
    "type": "object",
    "allOf": [
        {
            "$ref": "base.json"
        }
    ],
    "properties": {
        "shape": {
            "const": "box"
        },
        "min_coordinate": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
        },
        "max_coordinate": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
        }
    },
    "required": [
        "shape",
        "min_coordinate",
        "max_coordinate"
    ]
}
