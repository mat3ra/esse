{
    "$id": "material/primitive/base/vacuum",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Vacuum Schema",
    "description": "A vacuum slab that breaks periodicity in a specified direction",
    "type": "object",
    "properties": {
        "direction": {
            "allOf": [
                {
                    "$ref": "../../../core/primitive/axis_3d_names_enum.json"
                }
            ],
            "default": "z"
        },
        "size": {
            "type": "number",
            "description": "Size of the vacuum slab in angstroms",
            "minimum": 0,
            "default": 10
        },
        "is_orthogonal": {
            "type": "boolean",
            "description": "Whether the vacuum slab is orthogonal to the specified direction",
            "default": true
        }
    },
    "required": [
        "direction",
        "size"
    ]
}
