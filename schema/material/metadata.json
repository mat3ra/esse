{
    "$id": "material/metadata",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "material metadata schema",
    "type": "object",
    "properties": {
        "metadata": {
            "type": "object",
            "default": {},
            "additionalProperties": true,
            "anyOf": [
                {
                    "$ref": "metadata/boundary_conditions.json"
                },
                {
                    "$ref": "metadata/slab_properties.json"
                },
                {
                    "$ref": "metadata/bulk_properties.json"
                }
            ]
        }
    },
    "required": [
        "metadata"
    ]
}
