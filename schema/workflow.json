{
    "$id": "workflow",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "workflow schema",
    "type": "object",
    "allOf": [
        {
            "$ref": "in_memory_entity/named.json"
        },
        {
            "$ref": "system/metadata.json"
        },
        {
            "$ref": "workflow/base.json"
        },
        {
            "$ref": "system/description.json"
        },
        {
            "$ref": "system/tags.json"
        }
    ],
    "properties": {
        "workflows": {
            "description": "Array of workflows with the same schema as the current one.",
            "type": "array",
            "items": {
                "type": "object"
            }
        },
        "compute": {
            "description": "compute parameters",
            "$ref": "job/compute.json"
        }
    },
    "required": [
        "workflows"
    ]
}
