{
    "$id": "models-directory/legacy/dft-lda",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DFT LDA model schema",
    "type": "object",
    "required": [
        "type",
        "subtype",
        "functional",
        "method"
    ],
    "properties": {
        "type": {
            "const": "dft"
        },
        "subtype": {
            "const": "lda"
        },
        "functional": {
            "enum": [
                "pz",
                "pw",
                "vwn",
                "other"
            ]
        },
        "method": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "title": "base method",
            "type": "object",
            "required": [
                "type",
                "subtype"
            ],
            "properties": {
                "type": {
                    "description": "general type of this method, eg. `pseudopotential`",
                    "type": "string"
                },
                "subtype": {
                    "description": "general subtype of this method, eg. `ultra-soft`",
                    "type": "string"
                },
                "precision": {
                    "description": "Object showing the actual possible precision based on theory and implementation",
                    "type": "object"
                },
                "data": {
                    "description": "additional data specific to method, eg. array of pseudopotentials",
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                        "searchText": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}